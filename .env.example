# ---------------------------------------------------------------------------
# MarketHub backend - environment template.
#
# Copy to `.env` (git-ignored) or export these variables in your shell /
# container orchestrator. NEVER put a real credential in this file.
#
# Generate a JWT secret with one of:
#   openssl rand -base64 48
#   (PowerShell) [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# ---------------------------------------------------------------------------

# --- Database (required for the default/production profile) ----------------
DB_URL=jdbc:postgresql://localhost:5432/markethub_db
DB_USERNAME=postgres
# Required, no default: the application refuses to start without it.
DB_PASSWORD=change-me
# Connection pool sizing (HikariCP)
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Auth (required) -------------------------------------------------------
# Required, minimum 32 bytes. The application refuses to start without it.
JWT_SECRET=change-me-to-a-random-32+-byte-secret
# Optional access-token lifetime (milliseconds). There is no refresh-token
# flow in this application: a 24 h token is re-issued at the next login.
JWT_EXPIRATION_MS=86400000

# --- HTTP / CORS -----------------------------------------------------------
SERVER_PORT=8080
# Comma-separated list of the exact origins the frontend is served from.
# Required in the `prod` profile; must be https:// URLs.
CORS_ALLOWED_ORIGINS=https://www.example.com
# Set to `framework` when running behind a TLS-terminating reverse proxy so
# generated URLs and redirects use https://. Leave as `none` otherwise.
FORWARD_HEADERS_STRATEGY=framework
# Schema handling: Flyway owns the schema and Hibernate only validates it in
# every PostgreSQL profile (`validate`, the default in application.yml).
# The `local` H2 profile keeps `update` for its throwaway dev database.
JPA_DDL_AUTO=validate
# SQL logging - keep false in production (it can log row data).
SHOW_SQL=false

# --- Ops -------------------------------------------------------------------
# Root log level (INFO recommended in production)
LOG_LEVEL_ROOT=INFO
